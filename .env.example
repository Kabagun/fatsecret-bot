# Telegram
TELEGRAM_BOT_TOKEN=123456:replace-me
# Optional Telegram user ID allowed to use admin-only features such as multiple groups and diary copying.
TELEGRAM_ADMIN_USER_ID=

# Runtime SQLite location. Keep it under temp/ so secrets/runtime state stay uncommitted.
FATSECRET_BOT_DB_PATH=temp/state/fatsecret_bot.sqlite3

# Detailed bot trace. Rotated daily; files older than the retention window are removed.
# If omitted, the log is written next to FATSECRET_BOT_DB_PATH as fatsecret_bot.log.
FATSECRET_BOT_LOG_PATH=temp/state/fatsecret_bot.log
FATSECRET_BOT_LOG_RETENTION_DAYS=10

# Timezone used in bot-generated timestamps for recipes created from list mode.
FATSECRET_BOT_TIMEZONE=Europe/Minsk

# FatSecret app/device defaults from the captured Android app.
FATSECRET_APP_VERSION=11.5.0.4
FATSECRET_LANG=ru
FATSECRET_MKT=BY
FATSECRET_DEVICE=6
FATSECRET_BUILD_SDK=30
FATSECRET_BUILD_API=11
FATSECRET_BUILD_MODEL=NE2211
FATSECRET_BUILD_RESOLUTION=1920x1080
FATSECRET_DEVICE_IDENTIFIER=NE2211

# Optional override of the Android protocol Authorization header (default: FatSecret).
# A separate API key is not required for the account login used by this bot.
FATSECRET_AUTHORIZATION=
# Optional device descriptor override (defaults to this installation's stable device key).
FATSECRET_C_DESC=
FATSECRET_USER_AGENT=FatSecretBot/0.1
